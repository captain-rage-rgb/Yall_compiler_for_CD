func start() {
    let count = 0;
    till (count < 3) {
        ++count;
        if (count == 2) {
            skip;
        }
        if (count == 3) {
            stop;
        }
    }

    rep (let i = 0; i < 2; ++i) {
        rep (let j = 0; j < 2; ++j) {
            if (j == 1) {
                stop;
            }
        }
    }
}
