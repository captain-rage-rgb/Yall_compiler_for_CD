func start() {
    let sum = 0;
    rep (let i = 1; i <= 100; ++i) {
        sum += i;
    }
    out(sum);

    let n = 0;
    while (n < 5) {
        ++n;
        if (n == 2) {
            skip;
        }
        if (n == 4) {
            stop;
        }
        out(n);
    }

    rep (let x = 0; x < 2; ++x) {
        rep (let y = 0; y < 3; ++y) {
            if (y == 1) {
                stop;
            }
            out(x, y);
        }
    }
}
