let n = 10;

if (n > 20) {
    out("large");
} other if (n > 5) {
    out("medium");
} other {
    out("small");
}

while (n > 0) {
    n -= 1;
    if (n == 5) {
        skip;
    }
    if (n == 2) {
        stop;
    }
}

rep (let i = 0; i < n; ++i) {
    {
        let temp = i * 2;
        out(temp);
    }
}
