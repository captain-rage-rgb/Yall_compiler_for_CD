func start() {
    let n = 0;
    while (n < 5) {
        ++n;
        if (n == 2) {
            skip;
        }
        if (n == 4) {
            stop;
        }
    }

    rep (let i = 0; i < 3; ++i) {
        rep (let j = 0; j < 3; ++j) {
            if (j == 1) {
                skip;
            }
            if (j == 2) {
                stop;
            }
        }
        if (i == 1) {
            stop;
        }
    }
}
