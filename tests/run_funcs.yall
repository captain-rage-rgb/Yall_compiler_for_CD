func num fact(num n) {
    if (n <= 1) {
        end 1;
    }
    end n * fact(n - 1);
}

func num fib(num n) {
    if (n <= 0) {
        end 0;
    }
    if (n == 1) {
        end 1;
    }
    end fib(n - 1) + fib(n - 2);
}

func nothing logNothing(text msg) {
    out("log:", msg);
}

func num addThree(num a, num b, num c) {
    end a + b + c;
}

func start() {
    out(fact(10));
    out(fib(20));
    logNothing("testing");
    out(addThree(10, 20, 30));
    out(calledBefore(42));
}

func num calledBefore(num x) {
    end x * 2;
}
